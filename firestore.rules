rules_version = '2';

// GatorPlate Firestore rules (Sprint 05, tightened and guests added in Sprint 08). Deny by default; every allowed write is validated.
// Limits mirror AppConfig with a little headroom (rules count characters slightly differently than Swift).
// Test in the Rules Playground before publishing. Never ship test-mode (open) rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    // users/{uid}: owner-only. Written by guest start / sign-up (create), the guest upgrade and Settings/alerts
    // (update). Deleted only by the deleteAccount Cloud Function (Admin SDK bypasses rules). accountType, email,
    // createdAt and uid change only in the one-time guest upgrade.
    match /users/{uid} {
      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }

      function isValidName(value) {
        return isText(value, 1, 60);
      }

      // Lists: rules can't loop over elements, so keyword lengths and building IDs are checked in the app and
      // again by the onPostCreated function (AppConfig.alertFilter*).
      function isValidAlertFilters(filters) {
        return filters is map
          && filters.keys().hasAll(['mode', 'diets', 'includeUnknownDiet', 'places', 'avoidAllergens',
                                    'skipUnverifiedAllergens', 'foods', 'updatedAt'])
          && filters.keys().hasOnly(['mode', 'diets', 'includeUnknownDiet', 'places', 'avoidAllergens',
                                     'skipUnverifiedAllergens', 'foods', 'updatedAt'])
          && filters.mode in ['all', 'custom']
          && filters.diets is list && filters.diets.size() <= 3
          && filters.diets.hasOnly(['vegan', 'vegetarian', 'nonVegetarian'])
          && filters.includeUnknownDiet is bool
          && filters.places is list && filters.places.size() <= 15
          && filters.avoidAllergens is list && filters.avoidAllergens.size() <= 9
          && filters.avoidAllergens.hasOnly(['milk', 'eggs', 'fish', 'shellfish', 'treeNuts', 'peanuts', 'wheat', 'soy', 'sesame'])
          && filters.skipUnverifiedAllergens is bool
          && filters.foods is list && filters.foods.size() <= 10
          && filters.updatedAt == request.time;
      }

      function isValidProfileFields(data) {
        return isValidName(data.displayName)
          && (!('orgName' in data) || data.orgName == null
              || (data.accountType == 'organization' && isValidName(data.orgName)))
          && data.notificationsEnabled is bool
          && (!('quietHoursEnabled' in data) || data.quietHoursEnabled is bool)
          && (!('fcmInstallationId' in data) || isText(data.fcmInstallationId, 10, 256))
          && (!('acceptedTermsVersion' in data) || isText(data.acceptedTermsVersion, 1, 40))
          && (!('acceptedTermsAt' in data) || data.acceptedTermsAt is timestamp);
      }

      function isValidAccountCreate() {
        return request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'accountType',
                                                    'notificationsEnabled', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'accountType', 'orgName',
                                                   'notificationsEnabled', 'createdAt'])
          && isText(request.resource.data.email, 3, 254);
      }

      // Guests (Sprint 08): anonymous users browse and get alerts without an account. No email; the Terms
      // version accepted on the device is recorded at creation.
      function isValidGuestCreate() {
        return request.auth.token.firebase.sign_in_provider == 'anonymous'
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'accountType', 'notificationsEnabled',
                                                  'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'accountType', 'notificationsEnabled',
                                                   'createdAt', 'acceptedTermsVersion', 'acceptedTermsAt']);
      }

      // Settings, alerts and Terms. accountType, email, createdAt and uid never change here.
      function isValidSettingsUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'orgName', 'notificationsEnabled', 'quietHoursEnabled', 'fcmInstallationId',
              'fcmInstallationIdUpdatedAt', 'acceptedTermsVersion', 'acceptedTermsAt', 'alertFilters']);
      }

      // Sign-up as a guest links an email to the same uid, then turns the guest profile into an account once.
      // The email must be the one now on the ID token; "member since" is the upgrade time.
      function isValidGuestUpgrade() {
        return resource.data.accountType == 'guest'
          && request.resource.data.accountType in ['student', 'organization']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'displayName', 'email', 'accountType', 'orgName', 'createdAt'])
          && request.resource.data.email == request.auth.token.email
          && isText(request.resource.data.email, 3, 254)
          && request.resource.data.createdAt == request.time;
      }

      allow read: if isOwner();
      // Sign-up writes these keys (nil optionals are omitted). Alerts start off.
      allow create: if isOwner()
        && ((request.resource.data.accountType in ['student', 'organization'] && isValidAccountCreate())
            || (request.resource.data.accountType == 'guest' && isValidGuestCreate()))
        && request.resource.data.uid == uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.notificationsEnabled == false
        && isValidProfileFields(request.resource.data);
      allow update: if isOwner()
        && (isValidSettingsUpdate() || isValidGuestUpgrade())
        && isValidProfileFields(request.resource.data)
        // Validated only when written (it carries updatedAt == request.time).
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['alertFilters'])
            || isValidAlertFilters(request.resource.data.alertFilters));
      allow delete: if false;
    }

    // postAlerts/{postId}: "alert already sent" markers written only by the onPostCreated Cloud Function
    // (Admin SDK bypasses rules). No match here, so clients are denied by default.

    match /posts/{postId} {
      function profile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isValidNewPost(post) {
        return post.keys().hasAll([
              'authorUid', 'authorName', 'title', 'description', 'items', 'overallDietary',
              'allergenWarnings', 'cautions', 'buildingId', 'locationName', 'locationDetail',
              'latitude', 'longitude', 'hasPhoto', 'aiGenerated', 'editedAfterAI', 'status',
              'createdAt', 'expiresAt', 'updatedAt', 'deleteAt'])
          && post.keys().hasOnly([
              'authorUid', 'authorName', 'orgName', 'title', 'description', 'items', 'overallDietary',
              'allergenWarnings', 'cautions', 'estimatedServings', 'buildingId', 'locationName',
              'locationDetail', 'latitude', 'longitude', 'hasPhoto', 'photoSlots', 'aiGenerated', 'editedAfterAI',
              'status', 'createdAt', 'expiresAt', 'updatedAt', 'deleteAt'])
          // Author is the signed-in user with an account (guests can't post), named as in their own profile
          // (no impersonating orgs).
          && post.authorUid == request.auth.uid
          && profile().accountType in ['student', 'organization']
          && post.authorName == profile().displayName
          && (!('orgName' in post) || post.orgName == profile().get('orgName', null))
          // Content limits (AppConfig: title 120, description 150, items 8, cautions 4, detail 80).
          && isText(post.title, 1, 140)
          && isText(post.description, 1, 170)
          && post.items is list && post.items.size() >= 1 && post.items.size() <= 8
          && post.overallDietary in ['vegan', 'vegetarian', 'nonVegetarian', 'mixed', 'unknown']
          && post.allergenWarnings is list && post.allergenWarnings.size() <= 9
          && post.allergenWarnings.hasOnly(['milk', 'eggs', 'fish', 'shellfish', 'treeNuts', 'peanuts', 'wheat', 'soy', 'sesame'])
          && post.cautions is list && post.cautions.size() <= 4
          && (!('estimatedServings' in post)
              || (post.estimatedServings is int && post.estimatedServings >= 1 && post.estimatedServings <= 500))
          // Location: inside the SFSU campus rectangle (SFSUCampus.region). The app also checks the outline.
          && isText(post.buildingId, 1, 40)
          && isText(post.locationName, 1, 120)
          && isText(post.locationDetail, 1, 100)
          && post.latitude is number && post.latitude >= 37.71935 && post.latitude <= 37.72975
          && post.longitude is number && post.longitude >= -122.48546 && post.longitude <= -122.47476
          && post.hasPhoto is bool && post.aiGenerated is bool && post.editedAfterAI is bool
          // Uploaded photo slots (postImages/{id}.jpg = 0, {id}_1..3.jpg). Optional for older app builds.
          && (!('photoSlots' in post)
              || (post.photoSlots is list && post.photoSlots.size() <= 4
                  && post.photoSlots.hasOnly([0, 1, 2, 3])
                  && post.hasPhoto == (post.photoSlots.size() > 0)))
          && post.status == 'active'
          // Server time only; window 15-60 min with a few minutes of clock-skew slack.
          && post.createdAt == request.time
          && post.updatedAt == request.time
          && post.expiresAt is timestamp
          && post.expiresAt > request.time + duration.value(10, 'm')
          && post.expiresAt <= request.time + duration.value(65, 'm')
          // TTL deletes the post 24 h after it ends.
          && post.deleteAt == post.expiresAt + duration.value(24, 'h');
      }

      allow read: if signedIn();
      allow create: if signedIn() && isValidNewPost(request.resource.data);
      // Only "Mark as gone" by the author. Published posts are otherwise not editable.
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'gone'
        && request.resource.data.updatedAt == request.time;
      // Cleanup is done by the TTL policy on deleteAt.
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['postId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['postId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && isText(request.resource.data.postId, 1, 40)
        && isText(request.resource.data.reason, 1, 220)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow read, update, delete: if false;
    }
  }
}
