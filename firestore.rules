rules_version = '2';

// GatorPlate Firestore rules (Sprint 05). Deny by default; every allowed write is validated.
// Limits mirror AppConfig with a little headroom (rules count characters slightly differently than Swift).
// Test in the Rules Playground before publishing. Never ship test-mode (open) rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isText(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /posts/{postId} {
      function profile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isValidNewPost(post) {
        return post.keys().hasAll([
              'authorUid', 'authorName', 'title', 'description', 'items', 'overallDietary',
              'allergenWarnings', 'cautions', 'buildingId', 'locationName', 'locationDetail',
              'latitude', 'longitude', 'hasPhoto', 'aiGenerated', 'editedAfterAI', 'status',
              'createdAt', 'expiresAt', 'updatedAt', 'deleteAt'])
          && post.keys().hasOnly([
              'authorUid', 'authorName', 'orgName', 'title', 'description', 'items', 'overallDietary',
              'allergenWarnings', 'cautions', 'estimatedServings', 'buildingId', 'locationName',
              'locationDetail', 'latitude', 'longitude', 'hasPhoto', 'aiGenerated', 'editedAfterAI',
              'status', 'createdAt', 'expiresAt', 'updatedAt', 'deleteAt'])
          // Author is the signed-in user, named as in their own profile (no impersonating orgs).
          && post.authorUid == request.auth.uid
          && post.authorName == profile().displayName
          && (!('orgName' in post) || post.orgName == profile().get('orgName', null))
          // Content limits (AppConfig: title 120, description 150, items 8, cautions 4, detail 80).
          && isText(post.title, 1, 140)
          && isText(post.description, 1, 170)
          && post.items is list && post.items.size() >= 1 && post.items.size() <= 8
          && post.overallDietary in ['vegan', 'vegetarian', 'nonVegetarian', 'mixed', 'unknown']
          && post.allergenWarnings is list && post.allergenWarnings.size() <= 9
          && post.allergenWarnings.hasOnly(['milk', 'eggs', 'fish', 'shellfish', 'treeNuts', 'peanuts', 'wheat', 'soy', 'sesame'])
          && post.cautions is list && post.cautions.size() <= 4
          && (!('estimatedServings' in post)
              || (post.estimatedServings is int && post.estimatedServings >= 1 && post.estimatedServings <= 500))
          // Location: inside the SFSU campus rectangle (SFSUCampus.region). The app also checks the outline.
          && isText(post.buildingId, 1, 40)
          && isText(post.locationName, 1, 120)
          && isText(post.locationDetail, 1, 100)
          && post.latitude is number && post.latitude >= 37.71935 && post.latitude <= 37.72975
          && post.longitude is number && post.longitude >= -122.48546 && post.longitude <= -122.47476
          && post.hasPhoto is bool && post.aiGenerated is bool && post.editedAfterAI is bool
          && post.status == 'active'
          // Server time only; window 15-60 min with a few minutes of clock-skew slack.
          && post.createdAt == request.time
          && post.updatedAt == request.time
          && post.expiresAt is timestamp
          && post.expiresAt > request.time + duration.value(10, 'm')
          && post.expiresAt <= request.time + duration.value(65, 'm')
          // TTL deletes the post 24 h after it ends.
          && post.deleteAt == post.expiresAt + duration.value(24, 'h');
      }

      allow read: if signedIn();
      allow create: if signedIn() && isValidNewPost(request.resource.data);
      // Only "Mark as gone" by the author. Published posts are otherwise not editable.
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'gone'
        && request.resource.data.updatedAt == request.time;
      // Cleanup is done by the TTL policy on deleteAt.
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['postId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['postId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && isText(request.resource.data.postId, 1, 40)
        && isText(request.resource.data.reason, 1, 220)
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow read, update, delete: if false;
    }
  }
}
