// DEV environment: the Debug configuration. Firebase project gatorplate-9fa58, installs next to the App Store app.
// Set as the GatorPlate target's base configuration for Debug (Project > Info > Configurations).

PRODUCT_BUNDLE_IDENTIFIER = com.keyurdipakbhaisavalia.GatorPlate.dev
INFOPLIST_KEY_CFBundleDisplayName = GatorPlate Dev
// Folder under GatorPlate/Config/Firebase/ whose GoogleService-Info.plist is copied into the app (scripts/copy-firebase-config.sh).
GATORPLATE_ENV = Dev
// The plist must belong to this Firebase project, or the build fails.
GATORPLATE_FIREBASE_PROJECT_ID = gatorplate-9fa58
